"use client";

import { useParams } from "next/navigation";
import Link from "next/link";
import Image from "next/image";
import { formatPrice } from "@/lib/utils";
import { Spinner } from "@/components/ui/spinner";
import {
  Store,
  Package,
  Wrench,
  Star,
  CheckCircle,
  MapPin,
  Award,
  TrendingUp,
  ShoppingBag,
  Phone,
  Mail,
  Clock,
  Instagram,
  Facebook,
  Twitter,
  Youtube,
  Globe,
  MessageCircle,
} from "lucide-react";
import { OnlineStatusBadge } from "@/components/shared/online-status-badge";
import { StorefrontThemeProvider } from "@/components/storefront/theme-provider";
import { StorefrontHeader } from "@/components/storefront/header";
import { StorefrontFooter } from "@/components/storefront/footer";
import { useStorefront } from "@/hooks/use-storefront";
import { getStorefrontPath } from "@/lib/domain";
import type { Product, Service, Review } from "@/types";

export default function StorePage() {
  const params = useParams();
  const subdomain = params.subdomain as string;
  const { storeData, isLoading } = useStorefront(subdomain);

  if (isLoading) {
    return (
      <div className="flex min-h-[60vh] items-center justify-center">
        <Spinner />
      </div>
    );
  }

  if (!storeData?.store) {
    return (
      <div className="mx-auto max-w-6xl px-4 py-20 text-center">
        <Store className="mx-auto h-16 w-16 text-gray-200 mb-4" />
        <h2 className="text-xl font-bold text-gray-900 mb-2">Toko Tidak Ditemukan</h2>
        <p className="text-sm text-gray-500">Toko yang kamu cari tidak tersedia atau sudah tidak aktif.</p>
      </div>
    );
  }

  const {
    store,
    stats,
    products = [],
    services = [],
    reviews = [],
  } = storeData;
  const sellerAverageRating = Number(
    store.owner?.sellerProfile?.averageRating ?? stats.averageRating ?? 0,
  );
  const sellerTotalReviews = Number(
    store.owner?.sellerProfile?.totalReviews ?? stats.totalReviews ?? 0,
  );

  return (
    <StorefrontThemeProvider store={store}>
      <div className="min-h-screen bg-gray-50">
        {/* Header with Navigation */}
        <StorefrontHeader store={store} subdomain={subdomain} />

        {/* Hero Section with Banner */}
        <div className="relative overflow-hidden">
          {store.banner ? (
            <div className="relative h-64 sm:h-80 lg:h-96 w-full">
              <div className="absolute inset-0 bg-black/40 z-10" />
              <Image
                src={store.banner}
                alt={store.name}
                fill
                className="object-cover"
                priority
              />
            </div>
          ) : (
            <div 
              className="relative h-64 sm:h-80 lg:h-96 w-full"
              style={{
                backgroundColor: store.themeColor ? `${store.themeColor}20` : '#e0e7ff'
              }}
            >
              <div className="absolute inset-0 flex items-center justify-center">
                <Store className="h-32 w-32" style={{ color: store.themeColor ? `${store.themeColor}40` : '#c7d2fe' }} />
              </div>
            </div>
          )}
          
          {/* Store Info Card - Overlapping Banner */}
          <div className="relative z-20 mx-auto max-w-6xl px-4 -mt-20 sm:-mt-24">
            <div 
              className="overflow-hidden backdrop-blur-sm bg-white/95 shadow-2xl"
              style={{ 
                borderRadius: 'var(--store-radius-xl, 1.5rem)',
                border: '1px solid rgba(255, 255, 255, 0.8)'
              }}
            >
              <div className="p-6 sm:p-8">
                <div className="flex flex-col sm:flex-row items-start gap-6">
                  {/* Logo */}
                  <div className="relative group">
                    {store.logo ? (
                      <div className="relative">
                        <Image
                          src={store.logo}
                          alt={store.name}
                          width={96}
                          height={96}
                          className="object-cover w-20 h-20 sm:w-24 sm:h-24 ring-4 ring-white shadow-lg transition-transform group-hover:scale-105"
                          style={{ borderRadius: 'var(--store-radius-lg, 1rem)' }}
                        />
                        {store.isVerified && (
                          <div 
                            className="absolute -bottom-2 -right-2 p-1.5 rounded-full bg-white shadow-lg"
                            style={{ color: store.themeColor || 'rgb(59 130 246)' }}
                          >
                            <CheckCircle className="h-5 w-5 fill-current" />
                          </div>
                        )}
                      </div>
                    ) : (
                      <div 
                        className="flex h-20 w-20 sm:h-24 sm:w-24 items-center justify-center ring-4 ring-white shadow-lg transition-transform group-hover:scale-105" 
                        style={{ 
                          borderRadius: 'var(--store-radius-lg, 1rem)',
                          backgroundColor: store.themeColor ? `${store.themeColor}20` : 'rgb(219 234 254)'
                        }}
                      >
                        <Store className="h-10 w-10 sm:h-12 sm:w-12" style={{ color: store.themeColor || 'rgb(37 99 235)' }} />
                      </div>
                    )}
                  </div>

                  {/* Store Details */}
                  <div className="flex-1 min-w-0">
                    <div className="flex flex-wrap items-start gap-3 mb-3">
                      <h1 className="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 tracking-tight">
                        {store.name}
                      </h1>
                      {store.isVerified && !store.logo && (
                        <div className="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold" style={{
                          backgroundColor: store.themeColor ? `${store.themeColor}15` : 'rgb(219 234 254)',
                          color: store.themeColor || 'rgb(37 99 235)'
                        }}>
                          <CheckCircle className="h-3.5 w-3.5" />
                          Terverifikasi
                        </div>
                      )}
                    </div>
                    
                    <p className="text-sm text-gray-500 mb-4 flex items-center gap-2">
                      <span className="font-medium">@{store.subdomain}</span>
                      <span className="text-gray-300">•</span>
                      <OnlineStatusBadge
                        lastActiveAt={store.owner?.lastActiveAt || null}
                        showText
                        size="sm"
                      />
                    </p>

                    {store.description && (
                      <p className="text-sm sm:text-base text-gray-600 mb-4 leading-relaxed max-w-3xl">
                        {store.description}
                      </p>
                    )}

                    {/* Stats Grid */}
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-6">
                      <div className="flex items-center gap-3 p-3 rounded-xl bg-yellow-50 border border-yellow-100">
                        <div className="p-2 rounded-lg bg-white shadow-sm">
                          <Star className="h-5 w-5 text-yellow-500 fill-yellow-500" />
                        </div>
                        <div>
                          <p className="text-xs text-gray-500 font-medium">Rating</p>
                          <p className="text-lg font-bold text-gray-900">
                            {sellerTotalReviews > 0 ? sellerAverageRating.toFixed(1) : '—'}
                          </p>
                        </div>
                      </div>

                      <div 
                        className="flex items-center gap-3 p-3 rounded-xl border"
                        style={{
                          backgroundColor: store.themeColor ? `${store.themeColor}10` : 'rgb(239 246 255)',
                          borderColor: store.themeColor ? `${store.themeColor}30` : 'rgb(191 219 254)'
                        }}
                      >
                        <div className="p-2 rounded-lg bg-white shadow-sm">
                          <Package className="h-5 w-5" style={{ color: store.themeColor || 'rgb(59 130 246)' }} />
                        </div>
                        <div>
                          <p className="text-xs text-gray-500 font-medium">Produk</p>
                          <p className="text-lg font-bold text-gray-900">{stats.totalProducts}</p>
                        </div>
                      </div>

                      <div 
                        className="flex items-center gap-3 p-3 rounded-xl border"
                        style={{
                          backgroundColor: store.themeSecondary ? `${store.themeSecondary}10` : 'rgb(236 253 245)',
                          borderColor: store.themeSecondary ? `${store.themeSecondary}30` : 'rgb(167 243 208)'
                        }}
                      >
                        <div className="p-2 rounded-lg bg-white shadow-sm">
                          <Wrench className="h-5 w-5" style={{ color: store.themeSecondary || 'rgb(16 185 129)' }} />
                        </div>
                        <div>
                          <p className="text-xs text-gray-500 font-medium">Jasa</p>
                          <p className="text-lg font-bold text-gray-900">{stats.totalServices}</p>
                        </div>
                      </div>

                      <div className="flex items-center gap-3 p-3 rounded-xl bg-purple-50 border border-purple-100">
                        <div className="p-2 rounded-lg bg-white shadow-sm">
                          <Award className="h-5 w-5 text-purple-500" />
                        </div>
                        <div>
                          <p className="text-xs text-gray-500 font-medium">Ulasan</p>
                          <p className="text-lg font-bold text-gray-900">{sellerTotalReviews}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* Main Content */}
        <div className="mx-auto max-w-6xl px-4 py-8 sm:py-12">

          {/* Custom Pages Navigation */}
          {store.storePages && store.storePages.length > 0 && (
            <nav className="mb-8 flex flex-wrap gap-3">
              {store.storePages.map((page) => (
                <Link
                  key={page.id}
                  href={getStorefrontPath(subdomain, `/${page.slug}`)}
                  className="group relative overflow-hidden rounded-full border border-gray-200 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 transition-all hover:border-gray-300 hover:shadow-md"
                  style={{
                    transition: 'all 0.3s ease'
                  }}
                  onMouseEnter={(e) => {
                    if (store.themeColor) {
                      e.currentTarget.style.backgroundColor = `${store.themeColor}10`;
                      e.currentTarget.style.borderColor = store.themeColor;
                    }
                  }}
                  onMouseLeave={(e) => {
                    e.currentTarget.style.backgroundColor = 'white';
                    e.currentTarget.style.borderColor = 'rgb(229 231 235)';
                  }}
                >
                  <span className="relative z-10">{page.title}</span>
                </Link>
              ))}
            </nav>
          )}

          {/* Products Section */}
          <section className="mb-12">
            <div className="flex items-center justify-between mb-6">
              <div className="flex items-center gap-3">
                <div 
                  className="p-2.5 rounded-xl shadow-sm"
                  style={{
                    backgroundColor: store.themeColor ? `${store.themeColor}15` : 'rgb(219 234 254)'
                  }}
                >
                  <Package className="h-6 w-6" style={{ color: store.themeColor || 'rgb(37 99 235)' }} />
                </div>
                <div>
                  <h2 className="text-xl sm:text-2xl font-bold text-gray-900">Produk Kami</h2>
                  <p className="text-sm text-gray-500">Temukan produk berkualitas terbaik</p>
                </div>
              </div>
              {products.length > 0 && (
                <Link
                  href={getStorefrontPath(subdomain, "/products")}
                  className="group flex items-center gap-2 text-sm font-semibold transition-all hover:gap-3"
                  style={{ color: store.themeColor || 'rgb(37 99 235)' }}
                >
                  Lihat Semua
                  <span className="text-xs opacity-70">({stats.totalProducts})</span>
                  <svg className="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                  </svg>
                </Link>
              )}
            </div>
            
            {products.length === 0 ? (
              <div className="text-center py-16 px-4 rounded-2xl border-2 border-dashed border-gray-200 bg-gray-50">
                <ShoppingBag className="h-12 w-12 text-gray-300 mx-auto mb-3" />
                <p className="text-sm font-medium text-gray-500">Belum ada produk tersedia</p>
                <p className="text-xs text-gray-400 mt-1">Produk akan segera ditambahkan</p>
              </div>
            ) : (
              <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
                {products.map((p: Product) => (
                  <Link
                    key={p.id}
                    href={getStorefrontPath(subdomain, `/products/${p.slug || p.id}`)}
                    className="group overflow-hidden bg-white transition-all duration-300 hover:-translate-y-1"
                    style={{ 
                      borderRadius: 'var(--store-radius-lg, 1rem)',
                      border: '1px solid rgb(229 231 235)',
                      boxShadow: 'var(--store-shadow-sm, 0 1px 2px 0 rgb(0 0 0 / 0.05))'
                    }}
                  >
                    {(p.thumbnail || p.images?.[0]) ? (
                      <div className="relative aspect-[4/3] bg-gray-100 overflow-hidden">
                        <Image
                          src={p.thumbnail || p.images?.[0]}
                          alt={p.name}
                          fill
                          className="object-cover transition-transform duration-500 group-hover:scale-110"
                        />
                      </div>
                    ) : (
                      <div className="relative aspect-[4/3] bg-gray-100 flex items-center justify-center">
                        <Package className="h-12 w-12 text-gray-300" />
                      </div>
                    )}
                    <div className="p-4">
                      <h3 className="text-sm font-semibold text-gray-900 line-clamp-2 mb-2 min-h-[2.5rem] group-hover:text-gray-700 transition-colors">
                        {p.name}
                      </h3>
                      <div className="flex items-baseline gap-2">
                        <p className="text-base font-bold" style={{ color: store.themeColor || 'rgb(37 99 235)' }}>
                          {formatPrice(p.price)}
                        </p>
                      </div>
                    </div>
                  </Link>
                ))}
              </div>
            )}
          </section>

          {/* Services Section */}
          <section className="mb-12">
            <div className="flex items-center justify-between mb-6">
              <div className="flex items-center gap-3">
                <div 
                  className="p-2.5 rounded-xl shadow-sm"
                  style={{
                    backgroundColor: (store.themeSecondary || store.themeColor) ? `${store.themeSecondary || store.themeColor}15` : 'rgb(209 250 229)'
                  }}
                >
                  <Wrench className="h-6 w-6" style={{ color: store.themeSecondary || store.themeColor || 'rgb(16 185 129)' }} />
                </div>
                <div>
                  <h2 className="text-xl sm:text-2xl font-bold text-gray-900">Layanan Jasa</h2>
                  <p className="text-sm text-gray-500">Solusi profesional untuk kebutuhan Anda</p>
                </div>
              </div>
              {services.length > 0 && (
                <Link
                  href={getStorefrontPath(subdomain, "/services")}
                  className="group flex items-center gap-2 text-sm font-semibold transition-all hover:gap-3"
                  style={{ color: store.themeSecondary || store.themeColor || 'rgb(16 185 129)' }}
                >
                  Lihat Semua
                  <span className="text-xs opacity-70">({stats.totalServices})</span>
                  <svg className="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M9 5l7 7-7 7" />
                  </svg>
                </Link>
              )}
            </div>
            
            {services.length === 0 ? (
              <div className="text-center py-16 px-4 rounded-2xl border-2 border-dashed border-gray-200 bg-gray-50">
                <Wrench className="h-12 w-12 text-gray-300 mx-auto mb-3" />
                <p className="text-sm font-medium text-gray-500">Belum ada layanan jasa tersedia</p>
                <p className="text-xs text-gray-400 mt-1">Layanan akan segera ditambahkan</p>
              </div>
            ) : (
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
                {services.map((s: Service) => (
                  <Link
                    key={s.id}
                    href={getStorefrontPath(subdomain, `/services/${s.slug || s.id}`)}
                    className="group overflow-hidden bg-white transition-all duration-300 hover:-translate-y-1"
                    style={{ 
                      borderRadius: 'var(--store-radius-lg, 1rem)',
                      border: '1px solid rgb(229 231 235)',
                      boxShadow: 'var(--store-shadow-sm, 0 1px 2px 0 rgb(0 0 0 / 0.05))'
                    }}
                  >
                    {(s.thumbnail || s.gallery?.[0]) ? (
                      <div className="relative aspect-[16/9] bg-gray-100 overflow-hidden">
                        <Image
                          src={s.thumbnail || s.gallery?.[0]}
                          alt={s.name}
                          fill
                          className="object-cover transition-transform duration-500 group-hover:scale-110"
                        />
                      </div>
                    ) : (
                      <div className="relative aspect-[16/9] bg-gray-100 flex items-center justify-center">
                        <Wrench className="h-12 w-12 text-gray-300" />
                      </div>
                    )}
                    <div className="p-4">
                      <h3 className="text-sm font-semibold text-gray-900 line-clamp-2 mb-2 min-h-[2.5rem] group-hover:text-gray-700 transition-colors">
                        {s.name}
                      </h3>
                      <div className="flex items-baseline gap-2">
                        <span className="text-xs text-gray-500 font-medium">Mulai dari</span>
                        <p className="text-base font-bold" style={{ color: store.themeSecondary || store.themeColor || 'rgb(16 185 129)' }}>
                          {formatPrice(s.basePrice || s.packages?.[0]?.price)}
                        </p>
                      </div>
                    </div>
                  </Link>
                ))}
              </div>
            )}
          </section>

          {/* Reviews Section */}
          {reviews.length > 0 && (
            <section className="mb-12">
              <div className="flex items-center gap-3 mb-6">
                <div className="p-2.5 rounded-xl shadow-sm bg-yellow-50">
                  <Star className="h-6 w-6 text-yellow-500 fill-yellow-500" />
                </div>
                <div>
                  <h2 className="text-xl sm:text-2xl font-bold text-gray-900">Ulasan Pelanggan</h2>
                  <p className="text-sm text-gray-500">Testimoni dari pelanggan kami</p>
                </div>
              </div>
              
              <div className="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
                {reviews.map((r: Review) => (
                  <div
                    key={r.id}
                    className="group p-5 sm:p-6 bg-white transition-all duration-300 hover:-translate-y-1"
                    style={{ 
                      borderRadius: 'var(--store-radius-lg, 1rem)',
                      border: '1px solid rgb(229 231 235)',
                      boxShadow: 'var(--store-shadow-sm, 0 1px 2px 0 rgb(0 0 0 / 0.05))'
                    }}
                  >
                    <div className="flex items-start gap-4 mb-4">
                      <div className="relative">
                        <div className="h-12 w-12 rounded-full bg-gray-200 overflow-hidden ring-2 ring-white shadow-sm">
                          {r.giver?.avatar ? (
                            <Image
                              src={r.giver.avatar}
                              alt=""
                              width={48}
                              height={48}
                              className="object-cover"
                            />
                          ) : (
                            <div className="h-full w-full flex items-center justify-center text-gray-500 font-semibold text-lg">
                              {r.giver?.firstName?.[0] || '?'}
                            </div>
                          )}
                        </div>
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-semibold text-gray-900">
                          {r.giver?.firstName} {r.giver?.lastName}
                        </p>
                        <div className="flex items-center gap-1 mt-1">
                          {Array.from({ length: 5 }).map((_, i) => (
                            <Star
                              key={i}
                              className={`h-4 w-4 ${i < r.rating ? "text-yellow-400 fill-yellow-400" : "text-gray-200"}`}
                            />
                          ))}
                          <span className="ml-2 text-xs font-medium text-gray-500">
                            {r.rating}.0
                          </span>
                        </div>
                      </div>
                    </div>
                    {r.comment && (
                      <p className="text-sm text-gray-600 leading-relaxed line-clamp-3">
                        "{r.comment}"
                      </p>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          {/* Footer */}
          <footer className="mt-16 pt-8 border-t border-gray-200">
            <div className="flex flex-col sm:flex-row items-center justify-between gap-4">
              <div className="flex items-center gap-2 text-sm text-gray-500">
                <div 
                  className="p-1.5 rounded-lg"
                  style={{
                    backgroundColor: store.themeColor ? `${store.themeColor}15` : 'rgb(219 234 254)'
                  }}
                >
                  <Store className="h-4 w-4" style={{ color: store.themeColor || 'rgb(37 99 235)' }} />
                </div>
                <span>
                  Powered by{' '}
                  <a 
                    href="https://plazo.id" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    className="font-semibold hover:underline transition-colors"
                    style={{ color: store.themeColor || 'rgb(37 99 235)' }}
                  >
                    Plazo
                  </a>
                </span>
              </div>
              <div className="flex items-center gap-4 text-xs text-gray-400">
                <span>© 2024 {store.name}</span>
              </div>
            </div>
          </footer>
        </div>
      </div>
    </StorefrontThemeProvider>
  );
}
