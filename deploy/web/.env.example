# Copy file ini menjadi .env.backend-prod dan .env.backend-DEV di VPS-1 (/opt/plazo)
#
# ============================================
# .env.backend-prod (PRODUCTION)
# ============================================
NODE_ENV=production
APP_PORT=3001
APP_NAME="Plazo Marketplace SaaS"
APP_URL=https://api.plazo.id
FRONTEND_URL=https://plazo.id
MAIN_DOMAIN=plazo.id
BASE_DOMAIN=plazo.id
CORS_ORIGIN=https://plazo.id,https://www.plazo.id

# Database (VPS-2)
DATABASE_URL=postgresql://plazo_user:PASSWORD_POSTGRES@IP_VPS_2:5432/plazo_prod
REDIS_HOST=IP_VPS_2
REDIS_PORT=6379
REDIS_PASSWORD=PASSWORD_REDIS
REDIS_DB=0

# JWT
JWT_SECRET=GANTI_SECRET_ACAK_PANJANG_1
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=GANTI_SECRET_ACAK_PANJANG_2
JWT_REFRESH_EXPIRES_IN=604800

# Email & WhatsApp
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Plazo Marketplace <noreply@plazo.id>"
FONNTE_API_TOKEN=xxx
FONNTE_API_URL=https://api.fonnte.com/send

# Object storage (NetaCloud S3-compatible)
UPLOAD_STORAGE=s3
S3_ENDPOINT=https://object-storage.example.com
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx
S3_BUCKET=plazo-prod
S3_REGION=us-east-1
S3_PUBLIC_URL=https://plazo-prod.object-storage.example.com

KYC_ENCRYPTION_KEY=GANTI_KEY_ACAK
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# .env.backend-DEV (DEV)
# ============================================
# Sama seperti di atas, tapi:
# DATABASE_URL=postgresql://plazo_user:PASSWORD_POSTGRES@IP_VPS_2:5432/plazo_DEV
# REDIS_DB=1
# APP_URL=https://api-dev.plazo.id
# FRONTEND_URL=https://dev.plazo.id
# MAIN_DOMAIN=dev.plazo.id
# BASE_DOMAIN=dev.plazo.id
# CORS_ORIGIN=https://dev.plazo.id
# JWT_SECRET/JWT_REFRESH_SECRET: beda dari production!
