# Nested repository backups created during monorepo conversion
.git-backups/

# dependencies
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# build output
**/.next/
**/out/
**/dist/
**/build/
**/coverage/

# environment files
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# logs
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# uploads and generated assets
backend/uploads/
**/*.tsbuildinfo
frontend/next-env.d.ts

# local IDE/system files
.DS_Store
*.pem
.idea/
*.swp
*.swo
*~

# local deploy/provider state
**/.vercel/
**/.prisma/
backend/prisma/*.db
