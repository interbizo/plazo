# ============================================
# PLAZO MARKETPLACE — PRODUCTION ENVIRONMENT
# ============================================
# Domain: plazo.id
# API: api.plazo.id
# Stores: *.plazo.id
# ============================================

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://plazo_user:CHANGE_THIS_STRONG_PASSWORD@localhost:5432/plazo_db?connection_limit=50&pool_timeout=30&connect_timeout=15"

# ============================================
# JWT AUTHENTICATION
# ============================================
# IMPORTANT: Generate unique secrets before deploy!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_NEW_SECRET_WITH_COMMAND_ABOVE"
JWT_EXPIRES_IN="3600"
JWT_REFRESH_SECRET="GENERATE_NEW_SECRET_WITH_COMMAND_ABOVE"
JWT_REFRESH_EXPIRES_IN="604800"

# ============================================
# APPLICATION
# ============================================
NODE_ENV="production"
APP_PORT=3001
APP_NAME="Plazo Marketplace SaaS"
APP_URL="https://api.plazo.id"

# Domain configuration
MAIN_DOMAIN="plazo.id"
BASE_DOMAIN="plazo.id"
FRONTEND_URL="https://plazo.id"

# ============================================
# CORS
# ============================================
CORS_ORIGIN="https://plazo.id,https://api.plazo.id,https://www.plazo.id"

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cloudflare Turnstile (optional)
# TURNSTILE_SECRET_KEY=""

# ============================================
# REDIS
# ============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ============================================
# EMAIL — Resend
# ============================================
RESEND_API_KEY="re_XXXXXXXXXX"
RESEND_FROM_EMAIL="Plazo Marketplace <noreply@plazo.id>"

# ============================================
# PAGINATION
# ============================================
DEFAULT_PAGE=1
DEFAULT_LIMIT=10
MAX_LIMIT=100

# PM2
# PM2_INSTANCES=2

# ============================================
# FONNTE WHATSAPP API
# ============================================
FONNTE_API_TOKEN=your_fonnte_api_token_here
FONNTE_API_URL=https://api.fonnte.com/send

# ============================================
# AUTO BACKUP & GOOGLE DRIVE
# ============================================
# Backup otomatis (cron). BACKUP_CRON_SCHEDULE format cron 5-field (0 1 * * * = tiap hari 01:00).
BACKUP_AUTO_ENABLED=true
BACKUP_CRON_SCHEDULE=0 1 * * *

# Google Drive (OAuth) - file backup masuk ke akun Google.
# Setup:
# 1. Google Cloud Console -> Credentials -> OAuth Client ID (type Web),
#    redirect URI http://localhost:3005/oauth (untuk script token).
# 2. OAuth consent screen: tambahkan akun tujuan sebagai Test user, lalu Publish app
#    (refresh token di mode Testing hanya bertahan 7 hari).
# 3. Buat refresh token: node scripts/google-drive-token.js -> login -> salin token.
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Opsional: id folder tujuan (bagian URL setelah /folders/). Kosongkan = root.
GOOGLE_DRIVE_FOLDER_ID=
